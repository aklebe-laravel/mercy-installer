#!/usr/bin/env php
<?php
declare(strict_types = 1);

/*
 * Mercy CLI of the production server: ./mercy install | update | config | destroy
 * (also "php mercy ..."; tab completion only with "./mercy")
 */

use AklebeLaravel\MercyPhpDeployment\MercyApp;

require __DIR__.'/vendor/autoload.php';

$dest = __DIR__;
// same layout as the scaffold: templates (from the image), generated configs, project
new MercyApp($dest, $dest.'/resources/setup', $dest.'/storage/app/last-setup')
        // the project repository "project/" holds the configs (see README "Project repository")
        ->withProject($dest.'/project', ['prod' => 'setup.yaml'])
        ->runProd();
